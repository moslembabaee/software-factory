{
  "name": "software-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Software Factory — Phase 0 monorepo skeleton (SF-ADR-001: TypeScript strict; SF-ADR-002: PostgreSQL).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "npm run dev --workspace @software-factory/api",
    "typecheck": "npm run lint:tsc",
    "lint:tsc": "tsc --build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:up": "node --import tsx packages/storage/src/migrate.ts up",
    "migrate:down": "node --import tsx packages/storage/src/migrate.ts down",
    "migrate:verify": "node --import tsx packages/storage/src/verify-migrations.ts",
    "db:seed": "node --import tsx packages/storage/src/seed.ts",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "test": "vitest run && node --test tests/tooling/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.0.0",
    "js-yaml": "^4.3.2"
  }
}
