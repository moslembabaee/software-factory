{
  "name": "software-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Software Factory — Phase 0 monorepo skeleton (SF-ADR-001: TypeScript strict; SF-ADR-002: PostgreSQL).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
