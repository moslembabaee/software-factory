{
  "types": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true }
  ],
  "commitUrlFormat": "https://github.com/moslembabaee/software-factory/commit/{{hash}}",
  "compareUrlFormat": "https://github.com/moslembabaee/software-factory/compare/{{previousTag}}...{{currentTag}}",
  "issueUrlFormat": "https://github.com/moslembabaee/software-factory/issues/{{id}}",
  "userUrlFormat": "https://github.com/{{user}}",
  "releaseCommitMessageFormat": "chore(release): {{currentTag}}",
  "infile": "CHANGELOG.md",
  "packageFiles": [
    {
      "filename": "package.json",
      "type": "json"
    }
  ],
  "bumpFiles": [
    {
      "filename": "package.json",
      "type": "json"
    },
    {
      "filename": "apps/api/package.json",
      "type": "json"
    }
  ]
}
